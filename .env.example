# Copy to .env.local (or set as build variables in CI) to point the deployed site at a data source.
# Everything here is public in the built JS — never put tokens or passwords in VITE_* variables.

# manual | sheet | api
VITE_DATA_SOURCE=manual

# Backoffice API (see docs/BACKOFFICE_API.md)
VITE_BACKOFFICE_URL=
VITE_BACKOFFICE_AUTH_HEADER=Authorization

# Google Sheet / CSV links (normal Sheets links are converted to CSV export links automatically)
VITE_SHEET_PROMOS_URL=
VITE_SHEET_MONTHLY_URL=

# Auto-refresh in minutes for sheet/api (0 = off)
VITE_REFRESH_MINUTES=0

# Optional JSON field map, e.g. {"ggr_pre":"ggrBefore","brand_name":"operator"}
VITE_FIELD_MAP=
